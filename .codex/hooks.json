{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/tdd-guard.sh\"",
            "statusMessage": "Checking TDD guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/block-dangerous.sh\"",
            "statusMessage": "Checking for dangerous commands"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/block-poll-loop.sh\"",
            "statusMessage": "Checking for polling loops"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/rules-context.py\"",
            "timeout": 5,
            "statusMessage": "Injecting area rules",
            "additionalContextLimit": 32768
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/validate.sh\"",
            "timeout": 600,
            "statusMessage": "Running lint·build·test"
          }
        ]
      }
    ]
  }
}
